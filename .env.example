# ECHO SCOPE local config -- copy to .env and edit.
#
#     cp .env.example .env
#     nano .env
#     ./start.sh
#
# .env is git-ignored. start.sh sources it before launching the kiosk,
# so every key=value in here becomes an environment variable for the
# Python process and its child threads.
#
# Lines starting with '#' are comments. No quotes needed; whitespace
# around '=' is fine.


# ---- OpenAI ----------------------------------------------------------
# Primary chat backend. Get a key at https://platform.openai.com/api-keys.
# Leave blank to fall back to local hailo-ollama (qwen3:1.7b on the
# Hailo-10H).
OPENAI_API_KEY=


# ---- Admin auth ------------------------------------------------------
# /admin needs HTTP basic auth. If KIOSK_ADMIN_PASS is unset, start.sh
# generates a random one at every launch (printed in the banner). Set
# something stable here for a persistent password.
KIOSK_ADMIN_USER=admin
# KIOSK_ADMIN_PASS=change-me


# ---- Kiosk web port --------------------------------------------------
# Defaults to 8090. Bump it if 8090 clashes with something else on the
# Pi.
# KIOSK_PORT=8090


# ---- Hailo Whisper (NPU speech-to-text) ------------------------------
# CHAT_ASR_BACKEND lives in config.py and defaults to "auto" -- it
# picks Hailo automatically when the encoder HEF, decoder HEF, AND the
# decoder tokenization assets directory are all on disk.
# To use a non-default variant or paths, uncomment:
# HAILO_WHISPER_MODEL=base                  # "tiny" | "base" | "tiny.en"
# HAILO_WHISPER_ENCODER_HEF=/path/to/whisper-base-encoder.hef
# HAILO_WHISPER_DECODER_HEF=/path/to/whisper-base-decoder.hef
# HAILO_WHISPER_NPY_DIR=/path/to/whisper-base-assets
# HAILO_WHISPER_ADD_EMBED=false            # true for Hailo-8/8L, false for Hailo-10H
# See docs/hailo_asr.md for `pip install 'hailo-apps[speech-rec]'` --
# the speech-rec extra auto-downloads all three on first run.


# ---- Hailo-Ollama ----------------------------------------------------
# Skip auto-starting hailo-ollama when OPENAI_API_KEY is set (default).
# Flip to 1 to always preload it -- gives instant fallback at the cost
# of ~2.5 GB resident memory.
# PRELOAD_OLLAMA=0
# OLLAMA_URL=http://localhost:8000


# ---- Mic / speaker (already overridable on the command line) ---------
# SD_DEVICE=1
# AUDIO_OUTPUT_DEVICE=plughw:CARD=PowerConf,DEV=0
